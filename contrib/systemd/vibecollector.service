[Unit]
Description=Netflow Collector
After=network-online.target
Wants=network-online.target

[Service]
User=_vibecollector
ProtectSystem=true
StateDirectory=/var/lib/vibecollector
ExecStart=/usr/bin/vibecollector
WorkingDirectory=/var/lib/vibecollector
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
TimeoutStopSec=5

[Install]
WantedBy=default.target
